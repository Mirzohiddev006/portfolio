# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real secrets.

# 1. Create a bot with @BotFather on Telegram and copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy `message.chat.id`.
TELEGRAM_CHAT_ID=123456789

# 3. Create an Upstash Redis database and copy its REST credentials.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# 4. Generate a long random value; it is used to hash visitor identifiers.
VISITOR_HASH_SECRET=replace-with-a-long-random-secret
